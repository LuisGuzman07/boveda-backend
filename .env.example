APP_NAME=Boveda Hibrida API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

POSTGRES_DB=boveda_db
POSTGRES_USER=boveda_user
POSTGRES_PASSWORD=boveda_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://boveda_user:boveda_password@db:5432/boveda_db

# JWT & Authentication
# Required. Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholder below is intentionally rejected by the application.
JWT_SECRET_KEY=REPLACE_WITH_A_SECRET_GENERATED_OUTSIDE_THIS_REPOSITORY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Configuración SMTP (Gmail)
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion_16_caracteres
SMTP_FROM_EMAIL=tu_correo@gmail.com
SMTP_FROM_NAME="Bóveda Híbrida"
FRONTEND_URL=http://localhost:5173

