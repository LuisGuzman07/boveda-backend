APP_NAME=Boveda Hibrida API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

POSTGRES_DB=boveda_db
POSTGRES_USER=boveda_user
POSTGRES_PASSWORD=boveda_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://boveda_user:boveda_password@db:5432/boveda_db

# Optional CU-13/CU-14 S3-compatible replica. Leave disabled for local MinIO-only use.
S3_ENABLED=false
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=boveda-cifrada-replica
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SECURE=true
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=boveda-minio
MINIO_SECRET_KEY=boveda-minio-development
MINIO_BUCKET=boveda-cifrada
MINIO_SECURE=false

# JWT & Authentication
# Required. Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholder below is intentionally rejected by the application.
JWT_SECRET_KEY=REPLACE_WITH_A_SECRET_GENERATED_OUTSIDE_THIS_REPOSITORY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_VAULT_MAX_AGE_MINUTES=5
VAULT_SESSION_EXPIRE_MINUTES=5
DEVICE_CHALLENGE_TTL_SECONDS=120

# Browser refresh sessions are HttpOnly cookies protected by a separate CSRF cookie.
# Keep Secure enabled outside a local HTTP-only development environment.
SESSION_COOKIE_NAME=boveda_refresh
CSRF_COOKIE_NAME=csrf_token
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# Required for persisted TOTP. It is intentionally omitted from this template;
# inject a URL-safe base64-encoded 32-byte key from a local secret store.

# Configuración SMTP (Gmail)
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion_16_caracteres
SMTP_FROM_EMAIL=tu_correo@gmail.com
SMTP_FROM_NAME="Bóveda Híbrida"
FRONTEND_URL=http://localhost:5173

# Demo accounts are disabled by default. Enable only in a controlled environment
# and supply every account value through an external secret store or local .env.
SEED_DEMO_ACCOUNTS=0

